#version 450#extension GL_ARB_separate_shader_objects : enablelayout(location = 0) in vec2 fragUV;layout(location = 0) out vec4 outColor;layout(binding = 1) uniform sampler2D tex_1920;layout(binding = 2) uniform sampler2D tex_1600;layout(binding = 3) uniform sampler2D tex_1120;// Same binding as in vertex shaderlayout(binding = 0) uniform OverlayBufferObject {	float visible;	int hudVariant; // 0-6	int hudSizeVariant; // 0-2} oubo;void main() {	// replace last number with max number of hud variants	float hudHeight = 1.0 / 13.0;	int sliceIndex;	if (oubo.hudVariant <= 2) {		// Menu state: need 3x3 block		sliceIndex = oubo.hudSizeVariant * 3 + oubo.hudVariant;	} else {		// Remaining 4 unchanged slices: offset by +5		sliceIndex = 9 + (oubo.hudVariant - 3);	}	// Shift UVs to only sample from the selected vertical third	vec2 shiftedUV = fragUV;	shiftedUV.y = fragUV.y * hudHeight + sliceIndex * hudHeight;	vec4 texColor;	switch (oubo.hudSizeVariant) {		case 0: texColor = texture(tex_1920, shiftedUV); break;		case 1: texColor = texture(tex_1600, shiftedUV); break;		default: texColor = texture(tex_1120, shiftedUV); break;	}	// Optional: discard if alpha = 0 or use green keying	// if (texColor.rgb == vec3(0.0, 1.0, 0.0)) discard;	outColor = vec4(texColor.rgba);}