0); // stronger away from up	vec3 Diffuse = Albedo * max(dot(Norm, -gubo.lightDir), 0.0f);	vec3 Specular = vec3(pow(max(dot(EyeDir, -reflect(gubo.lightDir, Norm)), 0.0f), 200.0f));	// Quantize diffuse to simulate toon shading	float NdotL = max(dot(Norm, -gubo.lightDir), 0.0f);	float toonLevels = 4.0; // Number of brightness bands	float toonStep = floor(NdotL * toonLevels) / (toonLevels - 1.0);	// Replace the diffuse with the quantized version	Diffuse = Albedo * toonStep;	// Ambient term with fake AO applied	vec3 Ambient = (1.0 - aoStrength * FakeAO) * 0.3 * Albedo;	vec3 FinalColor = (Diffuse + Specular) * gubo.lightColor.rgb + Ambient;	outColor = vec4(FinalColor, 1.0f);}